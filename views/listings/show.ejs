<% layout('layouts/boilerplate.ejs') -%>
<div class="row">
    <div class="col-8 offset-2">

    <h3><%=listing.title%> :</h3>
    </div>
    <div class="col-6 offset-2">
    <div class="card">
        <img src="<%=listing.image.url || '/villa.jpg' %>" alt="<%= listing.title %>" class="card-img-top show-img-style">
         <p class="card-text"> &nbsp; Owned By <b><i><%= listing.owner.username %></i></b> 
        <div class="card-body">
               <b><%= listing.title %></b> <br>
                <i><%=listing.description %></i> <br>
                &#8377;<%= listing.price.toLocaleString('en-IN') %>
                <br>
                <%=listing.location %>
                <br> 
                <%=listing.country %>
            </p>
        </div>
    </div>
    
   <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
    <div class="btns">
        <h4>
            <a class="edit-link-style" href="/listings/<%= listing._id %>/edit">Edit this listing</a>
        </h4>
        <br> <br>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" >
            <button class="btn btn-primary">Delete this Listing</button>
        </form>
    </div>
    
</div>
<div class="col-8 offset-2">
    <h4>Leave your Reviews</h4>
    <form action="/listings/<%= listing._id %>/reviews" method="POST" class="mb-3 mt-3 needs-validation" novalidate>
        <div class="mb-3 mt-3">
            <label class="form-label" for="rating">Ratings⭐</label>
        <fieldset class="starability-heart">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" >4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5">5 stars</label>
        </fieldset>
        <div class="mb-3 mt-3">
            <label class="form-label"  class="form-control" for="comment">Comments</label>
            <textarea name="review[comment]" id="comment" class="form-control" required></textarea>
            <div class="invalid-feedback">'Pls fill comment section.</div>
        </div>
        <button class="btn btn-primary">Post</button>
    </form>
    <% } %>
    <br>
    <h4>See Reviews 👇</h4>
    <div class="review-container">
     <% for (let review of listing.reviews) { %>
        <div class="card ms-3 mb-3" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title"><%= review.author.username %></h5>
                <p class="starability-result" data-rating="<%= review.rating %>">
                    Rated: <%= review.rating %> stars
                </p>
                <h6 class="card-subtitle mb-2 text-body-secondary"><%= review.rating %>/5</h6>
                <p class="card-text"><%= review.comment %></p>
            </div>
            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"> 
                <button class="btn btn-primary ms-2" style="width: 6rem;">Delete</button>
            </form>
            <br>
        </div>
    <% } %>
    <br>
    </div>


</div>
</div>
